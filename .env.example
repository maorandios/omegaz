# Supabase — run supabase/migrations/001_initial_schema.sql in the SQL editor first.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase Dashboard → Authentication → URL configuration:
#   Site URL: https://app.getsegments.co
#   Redirect URLs: https://app.getsegments.co/** , http://localhost:5173/**
#
# Supabase Dashboard → Authentication → Providers:
#   Email: enabled (magic link)
#   Google: enabled — OAuth redirect URI in Google Cloud:
#     https://<project-ref>.supabase.co/auth/v1/callback
#
# Vercel (app project) → Environment Variables (Production + Preview):
#   VITE_SUPABASE_URL , VITE_SUPABASE_ANON_KEY — redeploy after saving.

# PayPal subscriptions — client (safe to expose in the browser bundle).
# For LOCAL DEV, set VITE_PAYPAL_PLAN_ID (and optionally VITE_PAYPAL_CLIENT_ID) in
# .env.local — the API routes are proxied to the live Vercel deployment (see
# vite.config.ts), so server-side PayPal secrets only need to live in Vercel env vars.
# Live plan: create in PayPal Dashboard (Live) → Subscriptions → copy Plan ID (P-...).
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_PLAN_ID=

# Override the dev API proxy target (defaults to https://app.getsegments.co).
# Useful if you want to point local dev at a Vercel preview URL with sandbox vars.
# VITE_DEV_API_TARGET=https://app-getsegments-co-git-feature-foo.vercel.app

# --- The rest below live in Vercel env vars only, not .env.local ---
# PayPal subscriptions — server (NEVER prefix with VITE_).
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
# Live: https://api-m.paypal.com  |  Sandbox: https://api-m.sandbox.paypal.com
PAYPAL_API_BASE=https://api-m.paypal.com
# Optional server-side plan id (falls back to VITE_PAYPAL_PLAN_ID if unset).
PAYPAL_PLAN_ID=

# Supabase service-role key — used by the Vercel API routes to update the
# `profiles` table from PayPal webhooks. Server-only; do NOT expose in the
# browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
