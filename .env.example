# Supabase — run supabase/migrations/001_initial_schema.sql in the SQL editor first.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase Dashboard → Authentication → URL configuration:
#   Site URL: https://app.getsegments.co
#   Redirect URLs: https://app.getsegments.co/** , http://localhost:5173/**
#
# Supabase Dashboard → Authentication → Providers:
#   Email: enabled (magic link)
#   Google: enabled — OAuth redirect URI in Google Cloud:
#     https://<project-ref>.supabase.co/auth/v1/callback
#
# Vercel (app project) → Environment Variables (Production + Preview):
#   VITE_SUPABASE_URL , VITE_SUPABASE_ANON_KEY — redeploy after saving.

# PayPal subscriptions — client (safe to expose in the browser bundle).
# Get the client id from PayPal Developer Dashboard → My Apps & Credentials.
# Create a Subscription Plan in GBP £39/month and paste its id below.
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_PLAN_ID=

# PayPal subscriptions — server (Vercel env vars only, NEVER prefix with VITE_).
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
# Switch to https://api-m.paypal.com once you're using the live PayPal app.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Supabase service-role key — used by the Vercel API routes to update the
# `profiles` table from PayPal webhooks. Server-only; do NOT expose in the
# browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
